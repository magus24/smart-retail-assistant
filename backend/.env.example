# Copy this file to `.env` and fill in your own keys.

# Groq — LLM intent & dialogue brain (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — real-time speech / TTS voices (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Admin API token for the knowledge-base panel (change in production!)
ADMIN_API_TOKEN=change_me
